# Copy to .env and replace placeholders. Never commit real secrets.
# The app starts locally with these development defaults. Do not use them in production.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://advlakhbirrpr_db_user:0obrnHno6B8nTgPC@cluster0.llfpj08.mongodb.net/tmsampark
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. At least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-string

# true behind HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Email. Leave blank locally. Messages are not marked sent unless SMTP accepts them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TMSAMPARK <noreply@example.com>

# Razorpay test mode. Leave blank to disable checkout. Never put live keys in git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# local or s3
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional malware scanning HTTP endpoint. Uploads are marked not_scanned when unset.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# Optional SMS provider. SMS is not marked sent unless a provider is configured.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Used only by the create-admin command. Leave blank in the file and pass flags instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
